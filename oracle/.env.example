# Soroban RPC endpoint. Defaults to Testnet if unset.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase. Defaults to Testnet if unset.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# The deployed vrf-oracle contract's ID (C...), from `stellar contract deploy`.
VRF_CONTRACT_ID=

# The oracle's Stellar ACCOUNT secret (S...). Used to sign and submit
# transactions. This is NOT the same as the BLS secret below - never mix
# these up. Fund this account (e.g. via Friendbot on Testnet) before use.
ORACLE_ACCOUNT_SECRET=

# The oracle's BLS12-381 secret scalar, hex-encoded (generate with
# `npm run keygen`). This is what makes randomness proofs valid; anyone
# who has it can forge proofs against the registered oracle_pubkey.
# NEVER commit this or share it outside of secure secret storage.
ORACLE_BLS_SECRET_HEX=

# How often (ms) the watch loop polls for new randomness_requested events.
POLL_INTERVAL_MS=5000

# Where the watch loop persists the last-processed ledger, so a restart
# doesn't reprocess or skip requests.
STATE_FILE=./state/last-ledger.json
